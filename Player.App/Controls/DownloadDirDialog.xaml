<Window x:Class="Player.App.Controls.DownloadDirDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="选择下载位置" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="下载到" Style="{StaticResource TitleTextStyle}" />
        <ListBox x:Name="DirList" Margin="0,8,0,0" MaxHeight="280"
                 Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource ModeButtonStyle}" Padding="10,5" Content="自定义…" Click="OnCustomClick" />
            <ui:Button Content="确定" Appearance="Primary" Margin="8,0,0,0" IsDefault="True" Click="OnOkClick" />
            <ui:Button Content="取消" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
