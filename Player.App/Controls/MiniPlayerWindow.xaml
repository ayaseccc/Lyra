<Window x:Class="Player.App.Controls.MiniPlayerWindow"
        x:Name="MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:Player.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="迷你播放器"
        Width="340" Height="104" MinWidth="272" MaxWidth="680" MinHeight="83.2" MaxHeight="208"
        WindowStyle="None" ResizeMode="CanResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" AllowsTransparency="False"
        Background="{DynamicResource MiniPlayerSurfaceBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="OnSurfacePointerDown"
        KeyDown="OnWindowKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="12"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="MiniActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource MiniPlayerSecondaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background"
                                        Value="{DynamicResource MiniPlayerHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource MiniPlayerTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniPlayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource MiniPlayerAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource MiniPlayerAccentForegroundBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.74" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSeekBarStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSeekThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSeekSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="2" VerticalAlignment="Bottom" CornerRadius="1"
                                    Background="{DynamicResource MiniPlayerBorderBrush}" />
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MiniSeekBarStyle}"
                                                  Background="{DynamicResource MiniPlayerAccentBrush}"
                                                  Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource MiniSeekBarStyle}"
                                                  Background="{DynamicResource MiniPlayerBorderBrush}"
                                                  Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource MiniSeekThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <Border x:Name="BorderRoot"
                Width="340" Height="104"
                CornerRadius="12"
                Background="{DynamicResource MiniPlayerSurfaceBrush}"
                BorderBrush="{DynamicResource MiniPlayerBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid Margin="10,10,10,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="64" Height="64"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            CornerRadius="6"
                            Background="{DynamicResource MiniPlayerCoverSurfaceBrush}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Width="48" Height="48"
                                   Source="pack://application:,,,/Assets/app.ico"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <Image Width="64" Height="64"
                                   Source="{Binding CoverImage}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,64,64" RadiusX="6" RadiusY="6" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="2"
                          Height="68"
                          VerticalAlignment="Top"
                          ClipToBounds="True">
                        <StackPanel x:Name="MetaPanel"
                                    VerticalAlignment="Top"
                                    Margin="0,2,0,0">
                            <Grid x:Name="TitleViewport" Height="19" ClipToBounds="True">
                                <TextBlock x:Name="TitleEllipsisText"
                                           Text="{Binding Title}"
                                           FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource MiniPlayerTextBrush}"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <Canvas ClipToBounds="True">
                                    <TextBlock x:Name="TitleMarqueeText"
                                               Canvas.Left="0" Canvas.Top="0"
                                               Text="{Binding Title}"
                                               FontSize="13" FontWeight="Medium"
                                               Foreground="{DynamicResource MiniPlayerTextBrush}"
                                               TextWrapping="NoWrap" Opacity="0">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="TitleTranslate" />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </Grid>
                            <TextBlock x:Name="ArtistText"
                                       Text="{Binding ArtistAndAlbum}"
                                       Margin="0,3,0,0"
                                       FontSize="11" FontWeight="Normal"
                                       Foreground="{DynamicResource MiniPlayerSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>

                        <controls:SpectrumBarsControl x:Name="SpectrumView"
                                                      Width="189"
                                                      Height="20"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Bottom"
                                                      BarBrush="{DynamicResource MiniPlayerAccentBrush}"
                                                      IsHitTestVisible="False" />

                        <StackPanel x:Name="HoverControls"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="HoverControlsTranslate" Y="3" />
                            </StackPanel.RenderTransform>
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    ToolTip="上一首"
                                    AutomationProperties.Name="上一首"
                                    Command="{Binding PreviousCommand}">
                                <ui:SymbolIcon Symbol="Previous16" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource MiniPlayButtonStyle}"
                                    Margin="3,0,0,0"
                                    ToolTip="播放 / 暂停"
                                    AutomationProperties.Name="播放或暂停"
                                    Command="{Binding PlayPauseCommand}">
                                <Grid>
                                    <ui:SymbolIcon Symbol="Play16" FontSize="16"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                    <ui:SymbolIcon Symbol="Pause16" FontSize="16"
                                                   Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Margin="3,0,0,0"
                                    ToolTip="下一首"
                                    AutomationProperties.Name="下一首"
                                    Command="{Binding NextCommand}">
                                <ui:SymbolIcon Symbol="Next16" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource MiniActionButtonStyle}"
                                    Margin="3,0,0,0"
                                    ToolTip="回到主窗口"
                                    AutomationProperties.Name="回到主窗口"
                                    Click="OnRestoreClick">
                                <ui:SymbolIcon Symbol="FullScreenMaximize16" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Slider x:Name="SeekSlider"
                        Margin="10,0,10,6"
                        VerticalAlignment="Bottom"
                        controls:SeekSliderBehavior.Enable="True"
                        Style="{StaticResource MiniSeekSliderStyle}"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=TwoWay}"
                        IsEnabled="{Binding HasTrack}"
                        LargeChange="5" SmallChange="1"
                        AutomationProperties.Name="播放进度" />
            </Grid>
        </Border>
    </Viewbox>
</Window>
