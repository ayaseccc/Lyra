<ui:FluentWindow x:Class="Player.App.Controls.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="迷你窗" Width="340" Height="104" WindowStyle="None" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        ExtendsContentIntoTitleBar="True" WindowCornerPreference="Round"
        Background="Transparent"
        KeyDown="OnWindowKeyDown">
    <Border x:Name="BorderRoot" CornerRadius="12" Padding="1"
            Background="{DynamicResource SurfaceStrongBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
        <Grid Margin="10,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 封面 -->
            <Border Width="48" Height="48" CornerRadius="6" Background="{DynamicResource HoverBrush}">
                <Grid>
                    <ui:SymbolIcon Symbol="MusicNote224" FontSize="20" Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding Player.CurrentTrack.CoverHash, Converter={StaticResource NullToVisible}}" />
                    <Image Source="{Binding Player.CurrentTrack.CoverHash, Converter={StaticResource CoverToImage}}"
                           Stretch="UniformToFill" />
                </Grid>
            </Border>

            <!-- 标题/艺术家（跑马灯） -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" ClipToBounds="True">
                <TextBlock x:Name="TitleText" Text="{Binding Player.Title}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Player.ArtistAndAlbum}" FontSize="10.5"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0" />
            </StackPanel>

            <!-- 悬停控件：上一曲/播放暂停/下一曲/回主窗 -->
            <StackPanel x:Name="HoverControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Margin="8,0,0,0" Opacity="0">
                <Button Style="{StaticResource TransportButtonStyle}" ToolTip="上一首"
                        Command="{Binding Player.PreviousCommand}">
                    <ui:SymbolIcon Symbol="Previous24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource TransportButtonStyle}" Margin="4,0,0,0" ToolTip="播放 / 暂停"
                        Command="{Binding Player.PlayPauseCommand}">
                    <Grid>
                        <ui:SymbolIcon Symbol="Play24" FontSize="16"
                                       Visibility="{Binding Player.IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ui:SymbolIcon Symbol="Pause24" FontSize="16"
                                       Visibility="{Binding Player.IsPlaying, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Button>
                <Button Style="{StaticResource TransportButtonStyle}" Margin="4,0,0,0" ToolTip="下一首"
                        Command="{Binding Player.NextCommand}">
                    <ui:SymbolIcon Symbol="Next24" FontSize="16" />
                </Button>
                <Button Style="{StaticResource ModeButtonStyle}" Margin="4,0,0,0" ToolTip="回到主窗" Click="OnRestoreClick">
                    <ui:SymbolIcon Symbol="Open24" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </StackPanel>

            <!-- 进度线 -->
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Height="2" Margin="0,6,0,0" Minimum="0" Maximum="100"
                         Value="{Binding Player.ProgressPercent}" />

            <!-- 频谱柱（设置可关） -->
            <Grid x:Name="SpectrumHost" Grid.Row="2" Grid.ColumnSpan="3" Height="14" Margin="0,4,0,0"
                  VerticalAlignment="Bottom">
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
