<ui:FluentWindow x:Class="Player.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Player.App.ViewModels"
                 xmlns:lyr="clr-namespace:Player.Core.Lyrics;assembly=Player.Core"
                 xmlns:p="clr-namespace:Player.Core.Audio;assembly=Player.Core"
                 xmlns:ctrl="clr-namespace:Player.App.Controls"
                 Title="Player" Height="900" Width="1400" MinHeight="540" MinWidth="920"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 DragOver="Window_OnDragOver"
                 Drop="Window_OnDrop"
                 PreviewKeyDown="Window_OnPreviewKeyDown"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 TextOptions.TextFormattingMode="Display">

    <ui:FluentWindow.Resources>

        <!-- ============ 曲目列表页 ============ -->
        <DataTemplate DataType="{x:Type vm:TrackListPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 返回（从专辑/艺术家钻进来时才有） -->
                <ui:Button Grid.Row="0" Margin="0,0,0,6" Appearance="Transparent"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Content="{Binding BackTitle}"
                           Command="{Binding BackCommand}"
                           Visibility="{Binding HasBack, Converter={StaticResource BoolToVis}}" />

                <!-- 标题栏 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 平铺/专辑分组切换（UI-R2，选择持久化） -->
                        <Button Style="{StaticResource ModeButtonStyle}" ToolTip="{Binding ViewModeToolTip}"
                                Command="{Binding ToggleViewModeCommand}">
                            <Grid>
                                <ui:SymbolIcon Symbol="AppsList24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="List24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsGrouped, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 列表（UI-R2：静态列头 + 扁平 ListBox，平铺/分组共用，虚拟化保持） -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <!-- L3.1 列自定义：宽度/顺序全绑 VM（隐藏列宽 0，顺序按索引） -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsGrouped, Converter={StaticResource BoolToGroupCoverWidth}}" />
                                <ColumnDefinition Width="{Binding ColWidthTitle, Converter={StaticResource DoubleToGridLength}}" />
                                <ColumnDefinition Width="{Binding ColWidthArtist, Converter={StaticResource DoubleToGridLength}}" />
                                <ColumnDefinition Width="{Binding ColWidthAlbum, Converter={StaticResource DoubleToGridLength}}" />
                                <ColumnDefinition Width="{Binding ColWidthDuration, Converter={StaticResource DoubleToGridLength}}" />
                                <ColumnDefinition Width="{Binding ColWidthFormat, Converter={StaticResource DoubleToGridLength}}" />
                                <ColumnDefinition Width="{Binding ColWidthSampleRate, Converter={StaticResource DoubleToGridLength}}" />
                                <ColumnDefinition Width="{Binding ColWidthBitDepth, Converter={StaticResource DoubleToGridLength}}" />
                                <ColumnDefinition Width="{Binding ColWidthBitrate, Converter={StaticResource DoubleToGridLength}}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="{Binding ColIndexTitle}" Visibility="{Binding ColIndexTitle, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="DisplayTitle" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="标题" Style="{StaticResource TrackHeaderLabelStyle}" />
                            </Border>
                            <Border Grid.Column="{Binding ColIndexArtist}" Visibility="{Binding ColIndexArtist, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="DisplayArtist" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="歌手" Style="{StaticResource TrackHeaderLabelStyle}" />
                            </Border>
                            <Border Grid.Column="{Binding ColIndexAlbum}" Visibility="{Binding ColIndexAlbum, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="DisplayAlbum" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="专辑" Style="{StaticResource TrackHeaderLabelStyle}" />
                            </Border>
                            <Border Grid.Column="{Binding ColIndexDuration}" Visibility="{Binding ColIndexDuration, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="DurationMs" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="时长" Style="{StaticResource TrackHeaderLabelStyle}" TextAlignment="Right" />
                            </Border>
                            <Border Grid.Column="{Binding ColIndexFormat}" Visibility="{Binding ColIndexFormat, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="Format" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="格式" Style="{StaticResource TrackHeaderLabelStyle}" />
                            </Border>
                            <Border Grid.Column="{Binding ColIndexSampleRate}" Visibility="{Binding ColIndexSampleRate, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="SampleRate" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="采样率" Style="{StaticResource TrackHeaderLabelStyle}" />
                            </Border>
                            <Border Grid.Column="{Binding ColIndexBitDepth}" Visibility="{Binding ColIndexBitDepth, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="BitDepth" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="位深" Style="{StaticResource TrackHeaderLabelStyle}" />
                            </Border>
                            <Border Grid.Column="{Binding ColIndexBitrate}" Visibility="{Binding ColIndexBitrate, Converter={StaticResource ColumnIndexToVis}}" Background="Transparent" Tag="Bitrate" Cursor="Hand"
                                    MouseLeftButtonUp="OnTrackHeaderClick">
                                <TextBlock Text="码率" Style="{StaticResource TrackHeaderLabelStyle}" />
                            </Border>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding DisplayItems}"
                             SelectionMode="Extended"
                             ItemContainerStyle="{StaticResource TrackRowStyle}"
                             Background="Transparent" BorderThickness="0"
                             AllowDrop="True"
                             DragOver="OnTrackListDragOver"
                             Drop="OnTrackListDrop"
                             SelectionChanged="OnTrackListSelectionChanged"
                             MouseDoubleClick="OnTrackListDoubleClick"
                             PreviewMouseLeftButtonDown="OnTrackListPreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="OnTrackListPreviewMouseLeftButtonUp"
                             MouseMove="OnTrackListMouseMove"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <!-- 显式标准模板：WPF-UI 对 ListBox 的隐式模板不生成滚动条（UI-R2 bug 修复） -->
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Focusable="False" CanContentScroll="True"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Visible"
                                              Padding="{TemplateBinding Padding}">
                                    <ScrollViewer.Template>
                                        <!-- 标准双列模板（内容+滚动条各占位）：绕开 WPF-UI 的悬浮式 ScrollViewer 隐式样式 -->
                                        <ControlTemplate TargetType="ScrollViewer">
                                            <Grid Background="{TemplateBinding Background}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                        Grid.Row="0"
                                                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                                                        Content="{TemplateBinding Content}"
                                                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                        Margin="{TemplateBinding Padding}" />
                                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1"
                                                           Orientation="Vertical"
                                                           VerticalAlignment="Stretch"
                                                           ViewportSize="NaN"
                                                           Maximum="{TemplateBinding ScrollableHeight}"
                                                           Value="{TemplateBinding VerticalOffset}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                           Cursor="Arrow" />
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- 组头行（UI-R2 定稿细行；L3.1 加封面缩略图+折叠箭头+点击折叠） -->
                                <Grid Visibility="{Binding IsGroupHeader, Converter={StaticResource BoolToVis}}"
                                      MouseLeftButtonUp="OnGroupHeaderClick">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DataContext.GroupCoverWidth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="2"
                                            VerticalAlignment="Center" Margin="4,0"
                                            Background="{DynamicResource HoverBrush}">
                                        <Grid>
                                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="14" Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding CoverHash, Converter={StaticResource NullToVisible}}" />
                                            <Image Source="{Binding CoverHash, Converter={StaticResource CoverToImage}}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding IsCollapsed, Converter={StaticResource BoolToCollapseArrow}}"
                                               FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding AlbumText}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <Border Grid.Column="3" Width="96" Height="1" VerticalAlignment="Center"
                                            Background="{DynamicResource BorderSoftBrush}" Margin="0,0,10,0" />
                                    <TextBlock Grid.Column="4" Text="{Binding YearText}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                </Grid>
                        
                                <!-- 曲目行：封面 72 + 标题/艺术家 + 信息列；组内非首行封面降透明 -->
                                <Grid Visibility="{Binding IsGroupHeader, Converter={StaticResource InverseBoolToVisibility}}">
                                    <!-- L3.1 列自定义：与列头同构（宽度/顺序绑 VM） -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding DataContext.IsGrouped, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToGroupCoverWidth}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthTitle, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthArtist, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthAlbum, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthDuration, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthFormat, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthSampleRate, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthBitDepth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                        <ColumnDefinition Width="{Binding DataContext.ColWidthBitrate, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource DoubleToGridLength}}" />
                                    </Grid.ColumnDefinitions>
                        
                                    <Border Grid.Column="0" Width="72" Height="72" CornerRadius="2"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource HoverBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="0.35" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowCover}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.IsGrouped, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="24"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding Track.CoverHash, Converter={StaticResource NullToVisible}}" />
                                            <Image Source="{Binding Track.CoverHash, Converter={StaticResource CoverToImage}}"
                                                   Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                        
                                    <StackPanel Grid.Column="{Binding DataContext.ColIndexTitle, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexTitle, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                                Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Play24" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Value="True">
                                                            <DataTrigger.Binding>
                                                                <MultiBinding Converter="{StaticResource TrackIsCurrent}">
                                                                    <Binding Path="Track.Path" />
                                                                    <Binding Path="DataContext.Player.CurrentTrack.Path"
                                                                             RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                </MultiBinding>
                                                            </DataTrigger.Binding>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Track.DisplayTitle}" FontSize="12"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Track.DisplayArtist}" FontSize="10.5"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="{Binding DataContext.ColIndexArtist, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexArtist, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                               Text="{Binding Track.DisplayArtist}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{Binding DataContext.ColIndexAlbum, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexAlbum, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                               Text="{Binding Track.DisplayAlbum}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{Binding DataContext.ColIndexDuration, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexDuration, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                               Text="{Binding Track.DurationText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Right"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{Binding DataContext.ColIndexFormat, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexFormat, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                               Text="{Binding Track.Format}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{Binding DataContext.ColIndexSampleRate, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexSampleRate, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                               Text="{Binding Track.SampleRateText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{Binding DataContext.ColIndexBitDepth, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexBitDepth, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                               Text="{Binding Track.BitDepthText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="{Binding DataContext.ColIndexBitrate, RelativeSource={RelativeSource AncestorType=ListBox}}" Visibility="{Binding DataContext.ColIndexBitrate, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource ColumnIndexToVis}}"
                                               Text="{Binding Track.BitrateText}" FontSize="10.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>


                    <!-- 曲库页空状态。图标与说明文字设为不可命中：它们盖在列表上面，
                         否则会把拖放事件截走，导致拖到空列表中央走成"入库并开播"；
                         按钮本身必须保持可点 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowLibraryEmptyState, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon IsHitTestVisible="False" Symbol="MusicNote224" FontSize="42" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TrackEmptyBrush}" />
                        <TextBlock IsHitTestVisible="False" Text="这里还没有歌曲" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock IsHitTestVisible="False" Text="把音乐文件夹拖进窗口，或点下面的按钮添加媒体库目录" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource SubTextStyle}" />
                        <ui:Button Content="添加音乐文件夹" Margin="0,16,0,0" HorizontalAlignment="Center"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding AddLibraryFolderCommand}" />
                    </StackPanel>

                    <!-- 歌单页空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowPlaylistEmptyState, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon IsHitTestVisible="False" Symbol="AppsList24" FontSize="42" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TrackEmptyBrush}" />
                        <TextBlock IsHitTestVisible="False" Text="这个歌单还是空的" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock IsHitTestVisible="False" Text="把曲目或文件夹拖到左侧的歌单上，或在曲目上右键「添加到歌单」" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource SubTextStyle}" />
                        <ui:Button Content="添加文件…" Margin="0,16,0,0" HorizontalAlignment="Center"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Command="{Binding AddFilesCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ============ 专辑页 ============ -->
        <DataTemplate DataType="{x:Type vm:AlbumPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Width="200" PlaceholderText="过滤专辑 / 艺术家"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="播放选中"
                                   Icon="{ui:SymbolIcon Play24}" Command="{Binding PlaySelectedCommand}" />
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding View}"
                          SelectedItem="{Binding SelectedAlbum}"
                          ItemContainerStyle="{StaticResource CardRowStyle}"
                          Background="Transparent" BorderThickness="0"
                          MouseDoubleClick="OnAlbumListDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="2"
                                        Background="{DynamicResource HoverBrush}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="18"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Visibility="{Binding CoverHash, Converter={StaticResource NullToVisible}}" />
                                        <Image Source="{Binding CoverHash, Converter={StaticResource CoverToImage}}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Album}" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource SubTextStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- ============ 艺术家页 ============ -->
        <DataTemplate DataType="{x:Type vm:ArtistPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Width="200" PlaceholderText="过滤艺术家"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="播放选中"
                                   Icon="{ui:SymbolIcon Play24}" Command="{Binding PlaySelectedCommand}" />
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding View}"
                          SelectedItem="{Binding SelectedArtist}"
                          ItemContainerStyle="{StaticResource CardRowStyle}"
                          Background="Transparent" BorderThickness="0"
                          MouseDoubleClick="OnArtistListDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22"
                                        Background="{DynamicResource HoverBrush}">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="18"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource SubTextStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- ============ 设置页（UI-R3 反馈：分页） ============ -->
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- L3.0-3 左侧竖排窄导航（外观/播放/资料库/在线/系统五大区） -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0" ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection}"
                             ItemContainerStyle="{StaticResource SimpleRowStyle}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource TitleTextStyle}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="14,0,0,0">

                        <!-- ===== 主题页（UI-R3） ===== -->
                        <Border Visibility="{Binding IsAppearanceSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="底色" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeBases}"
                                              SelectedItem="{Binding SelectedThemeBase}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="染色" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding ThemeTint}" Content="随封面染色" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 外观区：列表（L3.1） ===== -->
                        <Border Visibility="{Binding IsAppearanceSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="行高" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RowHeights}"
                                              SelectedItem="{Binding SelectedRowHeight}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="分组" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding GroupsExpandedByDefault}" Content="默认展开（手动切换每组状态会记住）" />
                                        <ui:ToggleSwitch IsChecked="{Binding GroupCoverVisible}" Content="分组标题显示封面" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 外观区：列（L3.1） ===== -->
                        <Border Visibility="{Binding IsAppearanceSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="0,12,0,0">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ColumnRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible}"
                                                          VerticalAlignment="Center" />
                                                <Slider Grid.Column="1" Minimum="40" Maximum="400" Value="{Binding Width}"
                                                        VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <Button Grid.Column="2" Style="{StaticResource ModeButtonStyle}" Margin="6,0,0,0"
                                                        ToolTip="上移"
                                                        Command="{Binding DataContext.MoveColumnUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="ArrowUp24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Button>
                                                <Button Grid.Column="3" Style="{StaticResource ModeButtonStyle}" Margin="6,0,0,0"
                                                        ToolTip="下移"
                                                        Command="{Binding DataContext.MoveColumnDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="ArrowDown24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ===== 外观区：界面字体（L3.1） ===== -->
                        <Border Visibility="{Binding IsAppearanceSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="界面字体" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding UiFontOptions}"
                                              SelectedItem="{Binding SelectedUiFont}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字号缩放" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding FontScales}"
                                              SelectedItem="{Binding SelectedFontScale}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 外观区：颜色（L3.1） ===== -->
                        <Border Visibility="{Binding IsAppearanceSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Margin="0,12,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="强调色" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AccentColors}"
                                              SelectedItem="{Binding SelectedAccent}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="选中高亮" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.5" Value="{Binding SelectedOpacity}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="悬停高亮" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="0.5" Value="{Binding HoverOpacity}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 输出页（P2） ===== -->
                        <Border Visibility="{Binding IsPlaybackSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="后端" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="设备" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}"
                                              SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" />
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="刷新"
                                               Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshDevicesCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,10" Visibility="{Binding IsWasapi, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="独占模式" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding Exclusive}" Content="独占设备（可位完美，其它程序将无声）" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="采样率" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding RateModes}"
                                              SelectedItem="{Binding SelectedRateMode}" />
                                    <ComboBox Grid.Column="2" Margin="8,0,0,0" Width="120"
                                              ItemsSource="{Binding FixedRates}" SelectedItem="{Binding SelectedFixedRate}"
                                              Visibility="{Binding IsFixedRate, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <Grid Margin="0,0,0,10" Visibility="{Binding IsAsio, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ASIO" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AsioBuffers}"
                                              SelectedItem="{Binding SelectedAsioBuffer}" />
                                    <ComboBox Grid.Column="2" Margin="8,0,0,0" ItemsSource="{Binding AsioChannels}"
                                              SelectedItem="{Binding SelectedAsioChannel}" />
                                </Grid>

                                <Grid Margin="0,0,0,10" Visibility="{Binding IsWasapi, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="缓冲区" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding WasapiBuffers}"
                                              SelectedItem="{Binding SelectedWasapiBuffer}" />
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="迷你窗" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding MiniSpectrum}" Content="迷你窗频谱（mixer DSP tap，不影响 ASIO 输出）" />
                                    </StackPanel>
                                </Grid>

                                <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="10,8" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Speaker224" FontSize="14" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding OutputStatus}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Style="{StaticResource SubTextStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===== 媒体库页 ===== -->
                        <Border Visibility="{Binding IsLibrarySec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <ui:Button Content="添加文件夹" Appearance="Primary"
                                               Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding AddFolderCommand}" />
                                    <ui:Button Content="导入 m3u8" Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportM3uCommand}" />
                                    <ui:Button Content="移除所选" Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveFolderCommand}" />
                                    <ui:Button Content="重新扫描（全量）" Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RescanCommand}" />
                                    <ui:Button Content="检查更新" Margin="8,0,0,0"
                                               Command="{Binding IncrementalScanCommand}" />
                                    <ui:Button Content="停止扫描" Margin="8,0,0,0"
                                               Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding CancelScanCommand}" />
                                </WrapPanel>

                                <Border CornerRadius="6" Padding="4" MinHeight="80" MaxHeight="260"
                                        Background="{DynamicResource HoverBrush}">
                                    <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}"
                                             Background="Transparent" BorderThickness="0"
                                             ItemContainerStyle="{StaticResource SimpleRowStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="14" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ===== 在线页（P3） ===== -->
                        <Border Visibility="{Binding IsOnlineSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <Border Background="{DynamicResource HoverBrush}" CornerRadius="6" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Cloud24" FontSize="14" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding QuotaDisplay}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextWrapping="Wrap" Style="{StaticResource SubTextStyle}" />
                                    </Grid>
                                </Border>

                                <TextBlock Text="API 列表" Margin="0,16,0,0" Style="{StaticResource TitleTextStyle}" />
                                <ItemsControl ItemsSource="{Binding ApiEndpoints}" Focusable="False" Margin="0,4,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="230" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding DataContext.ApiKinds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          SelectedItem="{Binding Kind}" />
                                                <ui:TextBox Grid.Column="1" Margin="8,0,0,0" PlaceholderText="API 地址"
                                                            Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                                                <ui:TextBox Grid.Column="2" Margin="8,0,0,0" PlaceholderText="Key（可选）"
                                                            Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" />
                                                <Button Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource ModeButtonStyle}"
                                                        ToolTip="删除"
                                                        Command="{Binding DataContext.RemoveApiEndpointCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Delete24" FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ui:Button Content="＋ 添加 API" Margin="0,8,0,0"
                                           Command="{Binding AddApiEndpointCommand}" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音质档" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BrOptions}"
                                              SelectedItem="{Binding PreviewBr}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 歌词页（L1 第三步 + L1.1 打磨） ===== -->
                        <Border Visibility="{Binding IsAppearanceSec, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="歌词字体" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LyricFonts}"
                                              SelectedItem="{Binding SelectedLyricFontFamily}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="字重" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Weights}"
                                              SelectedItem="{Binding SelectedLyricFontWeight}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="桌面歌词字号" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding LyricFontSizes}"
                                              SelectedItem="{Binding SelectedLyricFontSize}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="桌面歌词" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding DesktopLyricsTwoLines}" Content="显示翻译（双行）" />
                                        <ui:ToggleSwitch IsChecked="{Binding DesktopLyricsShowBackground}" Content="显示背景卡片" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="背景透明度" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding BgOpacities}"
                                              SelectedItem="{Binding SelectedDesktopLyricsBgOpacity}" />
                                </Grid>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="文字颜色" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding TextColors}"
                                              SelectedItem="{Binding SelectedDesktopLyricsTextColor}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 快捷键页（L2：可改绑清单 + 全局热键） ===== -->
                        <Border Visibility="{Binding IsSystemSec, Converter={StaticResource BoolToVis}}"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding ShortcutItems}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Description}"
                                                           Style="{StaticResource SubTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Style="{StaticResource ModeButtonStyle}" Margin="12,0,0,0"
                                                        MinWidth="120" Padding="10,3" FontWeight="SemiBold"
                                                        Content="{Binding Keys}"
                                                        Visibility="{Binding CanRebind, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.BeginRebindCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding ActionName}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="全局热键" VerticalAlignment="Top" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding GlobalHotkeysEnabled}" Content="启用（默认关闭）" />
                                        <ItemsControl ItemsSource="{Binding GlobalHotkeyItems}" Focusable="False" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Description}" Margin="0,0,12,0"
                                                                   Style="{StaticResource SubTextStyle}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Style="{StaticResource ModeButtonStyle}" Margin="12,0,0,0"
                                                                MinWidth="120" Padding="10,3" FontWeight="SemiBold"
                                                                Content="{Binding Keys}"
                                                                Command="{Binding DataContext.BeginRebindGlobalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding Name}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding RebindStatus}" Style="{StaticResource SubTextStyle}" Margin="0,8,0,0"
                                                   TextWrapping="Wrap" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 行为页（L2：关闭行为） ===== -->
                        <Border Visibility="{Binding IsSystemSec, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="关闭行为" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" Content="关闭时最小化到托盘" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="启动恢复" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <StackPanel Grid.Column="1">
                                        <ui:ToggleSwitch IsChecked="{Binding RestoreLastTrack}" Content="恢复上次播放的曲目（只恢复信息与歌词，不自动播放）" />
                                        <ui:ToggleSwitch IsChecked="{Binding RestoreLastNav}" Content="回到上次停留的页面" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ===== 关于页（L2 设置页补全） ===== -->
                        <Border Visibility="{Binding IsSystemSec, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0"
                                CornerRadius="8" Padding="16" Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="版本" VerticalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Grid.Column="1" Text="{Binding AppVersion}" VerticalAlignment="Center"
                                               Style="{StaticResource TitleTextStyle}" />
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BASS 授权" VerticalAlignment="Top" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"
                                               Text="音频引擎 BASS（un4seen）对个人 / 非商业使用免费；若未来上架收费需向 un4seen 购买授权。" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="开源组件" VerticalAlignment="Top" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SubTextStyle}" TextWrapping="Wrap"
                                               Text="WPF-UI（MIT）、CommunityToolkit.Mvvm（MIT）、Serilog（Apache-2.0）、TagLibSharp（LGPL-2.1）、ManagedBass（MIT）、Microsoft.Data.Sqlite（MIT）。" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Height="20" />
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ============ 在线搜索页（P4） ============ -->
        <DataTemplate DataType="{x:Type vm:OnlineSearchViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- 搜索栏：关键词 + 音源 + 专辑模式 + 音质 -->
                <Grid Grid.Row="1" Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="OnlineKeywordBox" PlaceholderText="歌名 / 歌手 / 专辑" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="搜索关键词"
                                KeyDown="OnOnlineSearchKeyDown" />
                    <ComboBox Grid.Column="1" MinWidth="110" Margin="8,0,0,0"
                              ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                              DisplayMemberPath="Name" />
                    <ui:ToggleSwitch Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                     IsChecked="{Binding IsAlbumMode}" Content="专辑" />
                    <ComboBox Grid.Column="3" MinWidth="110" Margin="12,0,0,0"
                              ItemsSource="{Binding BrOptions}" SelectedItem="{Binding SelectedBrOption}" />
                    <ui:Button Grid.Column="4" Margin="8,0,0,0" Appearance="Primary"
                               Content="搜索" Command="{Binding SearchCommand}"
                               IsEnabled="{Binding CanSearch}" />
                </Grid>

                <!-- 结果列表 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="标题" Style="{StaticResource TrackHeaderLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="歌手 / 专辑" Style="{StaticResource TrackHeaderLabelStyle}" />
                        <TextBlock Grid.Column="2" Text="时长" Style="{StaticResource TrackHeaderLabelStyle}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="音质" Style="{StaticResource TrackHeaderLabelStyle}" TextAlignment="Right" />
                    </Grid>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedItem}"
                             Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="OnOnlineSearchDoubleClick"
                             PreviewMouseRightButtonDown="OnOnlineSearchPreviewMouseRightButtonDown"
                             ContextMenuOpening="OnOnlineSearchContextMenuOpening"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                    <ScrollViewer Focusable="False" Padding="0" Margin="0">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="FocusVisualStyle" Value="{DynamicResource ThemeFocusVisualStyle}" />
                                <Setter Property="Padding" Value="0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Focusable" Value="True" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <!-- 右键菜单是独立弹出树，RelativeSource 跨树绑定必然哑（P1.1 老坑）；用 PlacementTarget + Click -->
                                        <ContextMenu PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}}">
                                            <!-- 注意：Style Setter 里的 ContextMenu 上写 XAML Click 处理器不生效（实测不触发），
                                                 统一在 ListBox.ContextMenuOpening 里 AddHandler 挂 MenuItem.ClickEvent -->
                                            <MenuItem Header="试听（临时播放）" />
                                            <MenuItem Header="下载" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitleTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding ArtistLine}" Style="{StaticResource SubTextStyle}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource SubTextStyle}"
                                               TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{Binding BrText}" Style="{StaticResource SubTextStyle}"
                                               TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Content="上一页" Command="{Binding PrevPageCommand}"
                                   IsEnabled="{Binding HasPreviousPage}" />
                        <TextBlock Grid.Column="1" Text="{Binding PageText}" Style="{StaticResource SubTextStyle}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ui:Button Grid.Column="2" Content="下一页" Command="{Binding NextPageCommand}"
                                   IsEnabled="{Binding HasMore}" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{Binding StatusText}" Style="{StaticResource SubTextStyle}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ============ 下载管理页（P4-5） ============ -->
        <DataTemplate DataType="{x:Type vm:DownloadPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding Items}" Margin="0,10,0,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                <ScrollViewer Focusable="False" Padding="0" Margin="0">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,6" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Focusable" Value="False" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="12,8" Margin="0,3"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource TitleTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ArtistLine}" Style="{StaticResource SubTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Style="{StaticResource SubTextStyle}" VerticalAlignment="Center" />
                                            <Button Style="{StaticResource ModeButtonStyle}" Margin="8,0,0,0" Padding="6,2"
                                                    FontSize="11" Content="取消" Click="OnDownloadCancelClick"
                                                    Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Progress 是只读属性，Value 默认 TwoWay 会抛 XamlParseException（2026-08-15 实机崩溃根因），必须 OneWay -->
                                    <ProgressBar Grid.Row="1" Height="3" Margin="0,6,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0"
                                                Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}">
                                        <ui:Button Content="继续下载" Appearance="Primary" Click="OnDownloadConfirmClick" />
                                        <ui:Button Content="取消" Margin="8,0,0,0" Click="OnDownloadCancelClick" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DataTemplate>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Player.WindowTitle}" Icon="{ui:SymbolIcon MusicNote224}"
                     Background="{DynamicResource SurfaceStrongBrush}" />

        <!-- ============ 三栏主体：左侧栏 + 内容 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" MinWidth="170" MaxWidth="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding Player.SidePaneWidth}" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8,0,0,0">
                <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,4">
                            <ui:TextBox x:Name="FilterBox" PlaceholderText="搜索当前列表" Height="30"
                                       Icon="{ui:SymbolIcon Search24}"
                                       Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    <!-- 底部：只剩扫描进度 + 状态提示（导入移入设置页、设置按钮移入播放条，UI-R1.5 反馈） -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,8,10,10">
                        <ProgressBar Height="2" Minimum="0" Maximum="100"
                                     Value="{Binding ScanPercent}"
                                     ToolTip="{Binding ScanStatus}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource SubTextStyle}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="48"
                                   Visibility="{Binding ShowStatusText, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             AllowDrop="True"
                             DragOver="OnNavDragOver"
                             Drop="OnNavDrop"
                             PreviewMouseRightButtonDown="OnNavListPreviewRightButtonDown"
                             MouseDoubleClick="OnNavListDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 分组标题（UI-R1.5 ⑧/⑩：媒体库/歌单标题带悬浮 + 按钮，空歌单是可点击的「＋ 新建歌单」） -->
                                    <Grid Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.ColumnSpan="2" Style="{StaticResource HeaderActionStyle}"
                                                Visibility="{Binding IsAction, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding Command}">
                                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="12" />
                                        </Button>
                                        <TextBlock Grid.ColumnSpan="2" Text="{Binding Title}"
                                                   Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsAction, Converter={StaticResource InverseBoolToVisibility}}" />
                                        <Button Grid.Column="1" Style="{StaticResource HeaderAddButtonStyle}"
                                                Visibility="{Binding ShowAddButton, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding Command}" ToolTip="{Binding AddToolTip}">
                                            <ui:SymbolIcon Symbol="Add24" FontSize="12" />
                                        </Button>
                                    </Grid>
                                    <!-- 普通条目 -->
                                    <Grid Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}">
<Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="导出 m3u8" Icon="{ui:SymbolIcon ArrowExport24}"
                                          Command="{Binding ExportCommand}" />
                                <Separator />
                                <MenuItem Header="重命名" Command="{Binding RenameCommand}" />
                                <MenuItem Header="删除" Command="{Binding DeleteCommand}" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,6,0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>
            <GridSplitter Grid.Column="3" Width="3" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ============ 右侧歌词栏（UI-R0 位置一：信息栏内嵌雏形） ============ -->
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1,0,0,0">
                <Grid Margin="12,10,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 大封面（正方形：高度跟随列宽，完整显示保持比例；2px 圆角与列表封面统一，UI-R1.5 ⑤） -->
                    <Border CornerRadius="2" Margin="0,0,0,10"
                            Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                            MaxHeight="420"
                            Background="{DynamicResource HoverBrush}"
                            BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                        <Grid>
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="44" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <Image Source="{Binding Player.CoverImage}" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="{Binding Player.Title}" Style="{StaticResource TitleTextStyle}" FontSize="14" />
                        <TextBlock Text="{Binding Player.ArtistAndAlbum}" Style="{StaticResource SubTextStyle}" Margin="0,3,0,0" />
                        <!-- UI-R4 制作信息区块：标签优先，LRC 头部补位，有才显示 -->
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0"
                                    Visibility="{Binding Player.Credits, Converter={StaticResource NonEmptyToVis}}">
                            <ui:SymbolIcon Symbol="Edit24" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding Player.Credits}" Margin="6,0,0,0" VerticalAlignment="Center"
                                       FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding Player.Lyrics.LyricCreditsText}" Margin="0,4,0,0"
                                   FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Player.Credits, Converter={StaticResource EmptyToVis}}" />
                        <!-- 来源信息已移入歌词右键菜单（UI-R1.5 ⑥） -->
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <ctrl:LyricCanvas x:Name="SideLyricCanvas"
                                          Lines="{Binding Player.Lyrics.RenderLines}"
                                          CurrentIndex="{Binding Player.Lyrics.CurrentIndex}"
                                          IsStatic="{Binding Player.Lyrics.IsStatic}"
                                          AccentBrush="{DynamicResource AccentBrush}"
                                          TextBrush="{DynamicResource TextPrimaryBrush}"
                                          SubTextBrush="{DynamicResource TextSecondaryBrush}"
                                          LineClicked="OnSideLyricClicked">
                        <ctrl:LyricCanvas.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="显示模式" IsEnabled="{Binding Player.Lyrics.HasTimeline}">
                                    <MenuItem Header="原文" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsOriginalMode, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetDisplayModeCommand}"
                                              CommandParameter="{x:Static vm:LyricDisplayMode.Original}" />
                                    <MenuItem Header="双语（原文 + 翻译）" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsBilingualMode, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetDisplayModeCommand}"
                                              CommandParameter="{x:Static vm:LyricDisplayMode.Bilingual}" />
                                    <MenuItem Header="罗马音" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsRomajiMode, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetDisplayModeCommand}"
                                              CommandParameter="{x:Static vm:LyricDisplayMode.Romaji}" />
                                </MenuItem>
                                <Separator />
<MenuItem Header="偏移 -0.1 秒" Command="{Binding Player.Lyrics.OffsetEarlierCommand}" />
                                <MenuItem Header="歌词来源">
                                    <MenuItem Header="自动（.lrc > 内嵌 > 缓存 > 网易云）" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefAuto, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.Auto}" />
                                    <MenuItem Header="本地 .lrc 文件" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefLrcFile, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.LrcFile}" />
                                    <MenuItem Header="内嵌标签" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefEmbedded, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.Embedded}" />
                                    <MenuItem Header="网易云" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefOnline, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.Online}" />
                                    <Separator />
                                    <MenuItem Header="{Binding Player.Lyrics.SourceDisplayText}" IsEnabled="False" />
                                </MenuItem>

                                <Separator />
                                <MenuItem Header="偏移 +0.1 秒" Command="{Binding Player.Lyrics.OffsetLaterCommand}" />
                                <MenuItem Header="{Binding Player.Lyrics.OffsetText}" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="重新获取" Command="{Binding Player.Lyrics.RefreshCommand}" />
                                <MenuItem Header="重新匹配…" Command="{Binding Player.Lyrics.RematchCommand}" />
                            </ContextMenu>
                        </ctrl:LyricCanvas.ContextMenu>
                    </ctrl:LyricCanvas>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Player.Lyrics.HasLyrics, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{Binding Player.Lyrics.StatusText}" Style="{StaticResource SubTextStyle}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>


        </Grid>

                        <!-- ============ 底部播放条（UI-R1.5 反馈：进度条整行在上、两端与最外侧按钮外缘对齐；按钮在下方一行） ============ -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceStrongBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="10,6" DataContext="{Binding Player}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 第一行：完整进度条（时间文字 + 滑条），整体缩短 10% 居中，两端与下方按钮行外缘对齐 -->
                <Grid Grid.Row="0" Margin="72,0,72,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource SubTextStyle}"
                               Width="46" VerticalAlignment="Center" />
                    <Slider Grid.Column="1" x:Name="SeekSlider" Margin="2,0" VerticalAlignment="Center"
                            ctrl:SeekSliderBehavior.Enable="True"
                            Style="{StaticResource SeekSliderStyle}"
                            Maximum="{Binding DurationSeconds}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            IsEnabled="{Binding HasTrack}"
                            LargeChange="5" SmallChange="1" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                               Style="{StaticResource SubTextStyle}" Width="46" TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>

                <!-- 第二行：左按钮组 | 控制键 | 右按钮组（含音量），外缘与滑条两端对齐（120=72内缩+46时间列+2滑条边距） -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModeButtonStyle}" ToolTip="设置"
                                Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
                        </Button>
                        <Button x:Name="BigLyricsButton" Style="{StaticResource ModeButtonStyle}" Margin="4,0,0,0" Click="OnBigLyricsButtonClick">
                            <Button.ToolTip>
                                <ToolTip x:Name="BigLyricsButtonTip" Content="大歌词页" />
                            </Button.ToolTip>
                            <ui:SymbolIcon Symbol="ReadingList24" FontSize="16" />
                        </Button>
                        <Button x:Name="DesktopLyricsButton" Style="{StaticResource ModeButtonStyle}" Margin="4,0,0,0" Click="OnDesktopLyricsButtonClick">
                            <Button.ToolTip>
                                <ToolTip x:Name="DesktopLyricsButtonTip" Content="桌面歌词" />
                            </Button.ToolTip>
                            <ui:SymbolIcon Symbol="ClosedCaption24" FontSize="16" />
                        </Button>
                        <Button x:Name="MiniButton" Style="{StaticResource ModeButtonStyle}" Margin="4,0,0,0" Click="OnMiniButtonClick">
                            <Button.ToolTip>
                                <ToolTip x:Name="MiniButtonTip" Content="迷你窗" />
                            </Button.ToolTip>
                            <ui:SymbolIcon Symbol="PictureInPicture24" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource TransportButtonStyle}" ToolTip="临时播放文件夹中的音乐"
                                Command="{Binding DataContext.PlayFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <ui:SymbolIcon Symbol="ArrowLeft24" FontSize="18" />
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding PreviousCommand}" ToolTip="上一首">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="18" />
                        </Button>
                        <Button Style="{StaticResource PrimaryPlayButtonStyle}" Margin="8,0"
                                Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24" FontSize="20"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="Pause24" FontSize="20"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding NextCommand}" ToolTip="下一首">
                            <ui:SymbolIcon Symbol="Next24" FontSize="18" />
                        </Button>
                        <Button Style="{StaticResource TransportButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding StopCommand}" ToolTip="停止">
                            <ui:SymbolIcon Symbol="Stop24" FontSize="16" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModeButtonStyle}" ToolTip="歌词面板"
                                Command="{Binding ToggleSidePaneCommand}">
                            <ui:SymbolIcon Symbol="AlignLeft24" FontSize="16"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                        <Button Style="{StaticResource ModeButtonStyle}" Margin="2,0,0,0"
                                ToolTip="左键切换播放模式 · 右键选择"
                                Command="{Binding CyclePlayModeCommand}">
                            <Grid>
                                <ui:SymbolIcon Symbol="ArrowRight24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsSequentialMode, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="ArrowRepeatAll24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsRepeatAllMode, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="ArrowRepeat124" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsRepeatOneMode, Converter={StaticResource BoolToVis}}" />
                                <ui:SymbolIcon Symbol="ArrowShuffle24" FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Visibility="{Binding IsShuffleMode, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="顺序播放" IsCheckable="True"
                                              IsChecked="{Binding IsSequentialMode, Mode=OneWay}"
                                              Command="{Binding SetPlayModeCommand}"
                                              CommandParameter="{x:Static p:PlayMode.Sequential}" />
                                    <MenuItem Header="列表循环" IsCheckable="True"
                                              IsChecked="{Binding IsRepeatAllMode, Mode=OneWay}"
                                              Command="{Binding SetPlayModeCommand}"
                                              CommandParameter="{x:Static p:PlayMode.RepeatAll}" />
                                    <MenuItem Header="单曲循环" IsCheckable="True"
                                              IsChecked="{Binding IsRepeatOneMode, Mode=OneWay}"
                                              Command="{Binding SetPlayModeCommand}"
                                              CommandParameter="{x:Static p:PlayMode.RepeatOne}" />
                                    <MenuItem Header="随机播放" IsCheckable="True"
                                              IsChecked="{Binding IsShuffleMode, Mode=OneWay}"
                                              Command="{Binding SetPlayModeCommand}"
                                              CommandParameter="{x:Static p:PlayMode.Shuffle}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource ModeButtonStyle}" Margin="2,0,0,0" ToolTip="定位正在播放"
                                Command="{Binding LocateCurrentTrackCommand}">
                            <ui:SymbolIcon Symbol="Target24" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource ModeButtonStyle}" Margin="2,0,0,0"
                                x:Name="OutputBadgeButton" ToolTip="{Binding OutputToolTip}">
                            <ui:SymbolIcon Symbol="PlugConnected24" FontSize="16" VerticalAlignment="Center"
                                           Foreground="{Binding IsBitPerfect, Converter={StaticResource BoolToTintBrush}}" />
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding OutputDevices}"
                                             DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                            <Setter Property="IsCheckable" Value="True" />
                                            <Setter Property="IsChecked" Value="{Binding IsCurrent, Mode=OneWay}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <ui:SymbolIcon Symbol="Speaker224" FontSize="15" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <!-- 音量：10 格方块，拖动/点击时短暂显示 dB（UI-R1.5 反馈） -->
                                        <Grid Width="86" Height="18" VerticalAlignment="Center" Margin="6,0,0,0"
                                              x:Name="VolumeSquares" Background="Transparent" Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" IsHitTestVisible="False" VerticalAlignment="Center">
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=0}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=1}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=2}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=3}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=4}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=5}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=6}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=7}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=8}" />
                                        <Border Width="5" Height="4" Margin="2,0" CornerRadius="0"
                                                Background="{DynamicResource VolumeReachedBrush}"
                                                Opacity="{Binding VolumeLevel, Converter={StaticResource VolumeSquare}, ConverterParameter=9}" />
                                            </StackPanel>
                                            <Popup IsOpen="{Binding IsVolumeFeedbackVisible}" Placement="Right"
                                                   AllowsTransparency="True" Focusable="False" HorizontalOffset="6">
                                                <TextBlock Text="{Binding VolumeDbText}" Style="{StaticResource SubTextStyle}"
                                                           VerticalAlignment="Center" />
                                            </Popup>
                                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>



            <!-- ============ 大歌词页（终版：无控制条/无×/无进度；Esc/双击退出；点行=跳转、点空白左/右半=上一曲/下一曲、滚轮浏览、空格=暂停） ============ -->
            <Grid x:Name="BigLyricsOverlay" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0"
                  Background="{DynamicResource SurfaceStrongBrush}" ClipToBounds="True"
                  Focusable="True" FocusVisualStyle="{x:Null}"
                  KeyboardNavigation.TabNavigation="None"
                  PreviewKeyDown="OnBigLyricsPreviewKeyDown"
                  PreviewMouseLeftButtonDown="OnBigLyricsOverlayMouseDown">
                <!-- 背景：放大模糊封面 + 遮罩保证可读 -->
                <Image x:Name="BigLyricsBgImage" Source="{Binding Player.CoverImage}"
                       Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                    </Image.RenderTransform>
                    <Image.Effect>
                        <BlurEffect Radius="36" />
                    </Image.Effect>
                </Image>
                <Border Background="{DynamicResource SurfaceStrongBrush}" Opacity="0.5" />
                <Border VerticalAlignment="Bottom" Height="220">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="1" Color="{DynamicResource SurfaceStrongColor}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 中央大字号歌词（复用 R5 引擎，1.8 倍） -->
                <Grid Margin="60,0,60,60">
                    <ctrl:LyricCanvas x:Name="BigLyricCanvas" FontScale="1.8"
                                      ClickMode="SeekOrNavigate" WheelBrowsing="True"
                                      Lines="{Binding Player.Lyrics.RenderLines}"
                                      CurrentIndex="{Binding Player.Lyrics.CurrentIndex}"
                                      IsStatic="{Binding Player.Lyrics.IsStatic}"
                                      AccentBrush="{DynamicResource AccentBrush}"
                                      TextBrush="{DynamicResource TextPrimaryBrush}"
                                      SubTextBrush="{DynamicResource TextSecondaryBrush}"
                                      LineClicked="OnBigLyricClicked"
                                      DoubleClicked="OnBigLyricDoubleClicked"
                                      BlankClicked="OnBigLyricBlankClicked" />
                </Grid>
            </Grid>
            </Grid>
</ui:FluentWindow>
