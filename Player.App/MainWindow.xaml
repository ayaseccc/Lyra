<ui:FluentWindow x:Class="Player.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:Player.App.ViewModels"
                 xmlns:lyr="clr-namespace:Player.Core.Lyrics;assembly=Player.Core"
                 Title="Player" Height="740" Width="1200" MinHeight="540" MinWidth="920"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 AllowDrop="True"
                 DragOver="Window_OnDragOver"
                 Drop="Window_OnDrop"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 TextOptions.TextFormattingMode="Display">

    <ui:FluentWindow.Resources>

        <!-- ============ 曲目列表页 ============ -->
        <DataTemplate DataType="{x:Type vm:TrackListPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 返回（从专辑/艺术家钻进来时才有） -->
                <ui:Button Grid.Row="0" Margin="0,0,0,6" Appearance="Transparent"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Content="{Binding BackTitle}"
                           Command="{Binding BackCommand}"
                           Visibility="{Binding HasBack, Converter={StaticResource BoolToVis}}" />

                <!-- 标题栏 -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Width="220" PlaceholderText="过滤 标题 / 歌手 / 专辑"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="播放全部"
                                   Icon="{ui:SymbolIcon Play24}" Command="{Binding PlayAllCommand}" />
                        <ui:Button Margin="8,0,0,0" Content="导出"
                                   Icon="{ui:SymbolIcon ArrowExport24}"
                                   Command="{Binding ExportM3uCommand}" />
                    </StackPanel>
                </Grid>

                <!-- 列表 -->
                <Grid Grid.Row="2">
                    <ListView ItemsSource="{Binding View}"
                              SelectedItem="{Binding SelectedTrack}"
                              SelectionMode="Extended"
                              ItemContainerStyle="{StaticResource TrackRowStyle}"
                              Background="Transparent" BorderThickness="0"
                              AllowDrop="True"
                              GridViewColumnHeader.Click="OnTrackHeaderClick"
                              SelectionChanged="OnTrackListSelectionChanged"
                              MouseDoubleClick="OnTrackListDoubleClick"
                              PreviewMouseLeftButtonDown="OnTrackListPreviewMouseLeftButtonDown"
                              PreviewMouseLeftButtonUp="OnTrackListPreviewMouseLeftButtonUp"
                              MouseMove="OnTrackListMouseMove"
                              DragOver="OnTrackListDragOver"
                              Drop="OnTrackListDrop"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource TrackHeaderStyle}">
                                <GridViewColumn Header="标题" Width="300" DisplayMemberBinding="{Binding DisplayTitle}" />
                                <GridViewColumn Header="歌手" Width="180" DisplayMemberBinding="{Binding DisplayArtist}" />
                                <GridViewColumn Header="专辑" Width="200" DisplayMemberBinding="{Binding DisplayAlbum}" />
                                <GridViewColumn Header="时长" Width="70" DisplayMemberBinding="{Binding DurationText}" />
                                <GridViewColumn Header="格式" Width="64" DisplayMemberBinding="{Binding Format}" />
                                <GridViewColumn Header="采样率" Width="86" DisplayMemberBinding="{Binding SampleRateText}" />
                                <GridViewColumn Header="位深" Width="64" DisplayMemberBinding="{Binding BitDepthText}" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="播放" Command="{Binding PlaySelectedCommand}" />
                                <MenuItem Header="添加到歌单"
                                          IsEnabled="{Binding HasPlaylistTargets}"
                                          ItemsSource="{Binding PlaylistMenuItems}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                            <Setter Property="CommandParameter" Value="{Binding Playlist}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="从歌单中移除" Command="{Binding RemoveSelectedCommand}"
                                          IsEnabled="{Binding CanEdit}" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>

                    <!-- 曲库页空状态。图标与说明文字设为不可命中：它们盖在列表上面，
                         否则会把拖放事件截走，导致拖到空列表中央走成"入库并开播"；
                         按钮本身必须保持可点 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowLibraryEmptyState, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon IsHitTestVisible="False" Symbol="MusicNote224" FontSize="42" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TrackEmptyBrush}" />
                        <TextBlock IsHitTestVisible="False" Text="这里还没有歌曲" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock IsHitTestVisible="False" Text="把音乐文件夹拖进窗口，或点下面的按钮添加媒体库目录" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource SubTextStyle}" />
                        <ui:Button Content="添加音乐文件夹" Margin="0,16,0,0" HorizontalAlignment="Center"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon FolderOpen24}"
                                   Command="{Binding AddLibraryFolderCommand}" />
                    </StackPanel>

                    <!-- 歌单页空状态 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowPlaylistEmptyState, Converter={StaticResource BoolToVis}}">
                        <ui:SymbolIcon IsHitTestVisible="False" Symbol="AppsList24" FontSize="42" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TrackEmptyBrush}" />
                        <TextBlock IsHitTestVisible="False" Text="这个歌单还是空的" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Style="{StaticResource TitleTextStyle}" />
                        <TextBlock IsHitTestVisible="False" Text="把曲目或文件夹拖到左侧的歌单上，或在曲目上右键「添加到歌单」" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource SubTextStyle}" />
                        <ui:Button Content="添加文件…" Margin="0,16,0,0" HorizontalAlignment="Center"
                                   Appearance="Primary"
                                   Icon="{ui:SymbolIcon Add24}"
                                   Command="{Binding AddFilesCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ============ 专辑页 ============ -->
        <DataTemplate DataType="{x:Type vm:AlbumPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Width="200" PlaceholderText="过滤专辑 / 艺术家"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="播放选中"
                                   Icon="{ui:SymbolIcon Play24}" Command="{Binding PlaySelectedCommand}" />
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding View}"
                          SelectedItem="{Binding SelectedAlbum}"
                          ItemContainerStyle="{StaticResource CardRowStyle}"
                          Background="Transparent" BorderThickness="0"
                          MouseDoubleClick="OnAlbumListDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="4"
                                        Background="{StaticResource HoverBrush}">
                                    <Grid>
                                        <ui:SymbolIcon Symbol="Album24" FontSize="18"
                                                       Foreground="{StaticResource TextTertiaryBrush}"
                                                       Visibility="{Binding CoverHash, Converter={StaticResource NullToVisible}}" />
                                        <Image Source="{Binding CoverHash, Converter={StaticResource CoverToImage}}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Album}" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource SubTextStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- ============ 艺术家页 ============ -->
        <DataTemplate DataType="{x:Type vm:ArtistPageViewModel}">
            <Grid Margin="18,8,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubTextStyle}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Width="200" PlaceholderText="过滤艺术家"
                                    Icon="{ui:SymbolIcon Search24}"
                                    Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="播放选中"
                                   Icon="{ui:SymbolIcon Play24}" Command="{Binding PlaySelectedCommand}" />
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding View}"
                          SelectedItem="{Binding SelectedArtist}"
                          ItemContainerStyle="{StaticResource CardRowStyle}"
                          Background="Transparent" BorderThickness="0"
                          MouseDoubleClick="OnArtistListDoubleClick"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22"
                                        Background="{StaticResource HoverBrush}">
                                    <ui:SymbolIcon Symbol="Person24" FontSize="18"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TitleTextStyle}" />
                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource SubTextStyle}"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </DataTemplate>

        <!-- ============ 设置页 ============ -->
        <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}">

        </DataTemplate>

    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Player" Icon="{ui:SymbolIcon MusicNote224}" />

        <!-- ============ 三栏主体：左侧栏 + 内容 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" MinWidth="190" MaxWidth="380" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="8,0,0,0">
                <DockPanel>
                    <!-- 底部：歌单操作 + 设置 + 扫描状态 -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,6,10,10">
                        <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" ToolTip="新建歌单"
                                       Icon="{ui:SymbolIcon Add24}" Command="{Binding CreatePlaylistCommand}" />
                            <ui:Button Appearance="Transparent" Margin="4,0,0,0" ToolTip="导入 m3u8"
                                       Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportM3uCommand}" />
                            <ui:Button Appearance="Transparent" Margin="4,0,0,0" ToolTip="设置"
                                       Icon="{ui:SymbolIcon Settings24}" Command="{Binding OpenSettingsCommand}" />
                        </StackPanel>

                        <ProgressBar Margin="0,8,0,0" Height="2" Minimum="0" Maximum="100"
                                     Value="{Binding ScanPercent}"
                                     Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ScanStatus}" Style="{StaticResource SubTextStyle}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="48" />

                        <!-- 输出指示：当前后端/设备/采样率，位完美时点亮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    ToolTip="{Binding Player.OutputHint}">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,6,0"
                                     Fill="{StaticResource AccentBrush}"
                                     Visibility="{Binding Player.IsBitPerfect, Converter={StaticResource BoolToVis}}" />
                            <ui:SymbolIcon Symbol="Speaker224" FontSize="12" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding Player.OutputDescription}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource SubTextStyle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             Background="Transparent" BorderThickness="0"
                             AllowDrop="True"
                             DragOver="OnNavDragOver"
                             Drop="OnNavDrop"
                             PreviewMouseRightButtonDown="OnNavListPreviewRightButtonDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 分组标题 -->
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionHeaderStyle}"
                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />
                                    <!-- 普通条目 -->
                                    <Grid Visibility="{Binding IsHeader, Converter={StaticResource InverseBoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="15" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="10,0,6,0"
                                                   VerticalAlignment="Center" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="Transparent" />

            <ContentControl Grid.Column="2" Content="{Binding CurrentPage}" />
        </Grid>

        <!-- ============ 底部播放条 ============ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceStrongBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,10" DataContext="{Binding Player}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="*" MaxWidth="270" />
                </Grid.ColumnDefinitions>

                <!-- 封面 + 曲目信息。点击封面展开歌词覆盖层（PLAN 第 8 节） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="6"
                            Background="{StaticResource HoverBrush}"
                            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                            Cursor="Hand" ToolTip="歌词"
                            MouseLeftButtonDown="OnCoverClick"
                            Focusable="True">
                        <Grid>
                            <ui:SymbolIcon Symbol="MusicNote224" FontSize="20"
                                           Foreground="{StaticResource TextTertiaryBrush}" />
                            <Image Source="{Binding CoverImage}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource SubTextStyle}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding TechnicalInfo}" Style="{StaticResource SubTextStyle}"
                                   Margin="0,2,0,0" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>

                <!-- 控制键 + 进度条 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding PreviousCommand}" ToolTip="上一首">
                            <ui:SymbolIcon Symbol="Previous24" FontSize="18" />
                        </Button>

                        <Button Style="{StaticResource PrimaryTransportButtonStyle}" Margin="10,0"
                                Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停">
                            <Grid>
                                <ui:SymbolIcon Symbol="Play24" FontSize="19"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ui:SymbolIcon Symbol="Pause24" FontSize="19"
                                               Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </Button>

                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding StopCommand}" ToolTip="停止">
                            <ui:SymbolIcon Symbol="Stop24" FontSize="16" />
                        </Button>

                        <Button Style="{StaticResource TransportButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding NextCommand}" ToolTip="下一首">
                            <ui:SymbolIcon Symbol="Next24" FontSize="18" />
                        </Button>
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource SubTextStyle}"
                                   Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Margin="10,0"
                                Style="{StaticResource SeekSliderStyle}"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding HasTrack}"
                                LargeChange="5" SmallChange="1" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}"
                                   Style="{StaticResource SubTextStyle}" Width="42" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- 播放模式 + 音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource TransportButtonStyle}"
                            Command="{Binding CyclePlayModeCommand}"
                            ToolTip="{Binding PlayModeText}">
                        <ui:SymbolIcon Symbol="{Binding PlayModeIcon}" FontSize="17" />
                    </Button>
                    <ui:SymbolIcon Symbol="Speaker224" FontSize="15" Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    <Slider Width="92" Margin="8,0" Maximum="1" LargeChange="0.1" SmallChange="0.05"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Style="{StaticResource VolumeSliderStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VolumePercentText}" Style="{StaticResource SubTextStyle}"
                               Width="34" VerticalAlignment="Center" />

                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 歌词覆盖层（P3.1-③ 改版）：只覆盖主区+播放条（Row 1-2），
             标题栏始终可点；退出三通道：页内关闭按钮 / Esc / 点击封面收起。
             操作全部收敛到歌词列表右键菜单（显示模式 / 偏移 / 重新获取 / 重新匹配） ============ -->
        <Grid Grid.Row="1" Panel.ZIndex="20"
              Visibility="{Binding Player.Lyrics.IsOpen, Converter={StaticResource BoolToVis}}"
              Background="{StaticResource LyricOverlayBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 头部：曲目信息 + 来源 + 关闭 -->
            <Border Background="{StaticResource SurfaceStrongBrush}"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Player.Title}" Style="{StaticResource PageTitleStyle}" FontSize="18" />
                        <TextBlock Text="{Binding Player.Artist}" Style="{StaticResource SubTextStyle}"
                                   Margin="14,4,0,0" VerticalAlignment="Center" FontSize="12" />

                    </StackPanel>
                    
                </Grid>
            </Border>

            <!-- 主体：大封面 + 歌词（右键菜单承载全部操作） -->
            <Grid Grid.Row="1" Margin="40,26,40,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 大封面 -->
                <Border Width="320" Height="320" CornerRadius="18"
                        Background="{StaticResource HoverBrush}"
                        BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Direction="270" />
                    </Border.Effect>
                    <Grid>
                        <ui:SymbolIcon Symbol="MusicNote224" FontSize="72" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}" />
                        <Image Source="{Binding Player.CoverImage}" Stretch="UniformToFill" />
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="32,0,0,0">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="显示模式" IsEnabled="{Binding Player.Lyrics.HasTimeline}">
                                    <MenuItem Header="原文" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsOriginalMode, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetDisplayModeCommand}"
                                              CommandParameter="{x:Static vm:LyricDisplayMode.Original}" />
                                    <MenuItem Header="双语（原文 + 翻译）" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsBilingualMode, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetDisplayModeCommand}"
                                              CommandParameter="{x:Static vm:LyricDisplayMode.Bilingual}" />
                                    <MenuItem Header="罗马音" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsRomajiMode, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetDisplayModeCommand}"
                                              CommandParameter="{x:Static vm:LyricDisplayMode.Romaji}" />
                                </MenuItem>
                                <Separator />
<MenuItem Header="偏移 -0.1 秒" Command="{Binding Player.Lyrics.OffsetEarlierCommand}" />
                                <MenuItem Header="歌词来源">
                                    <MenuItem Header="自动（.lrc > 内嵌 > 缓存 > 网易云）" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefAuto, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.Auto}" />
                                    <MenuItem Header="本地 .lrc 文件" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefLrcFile, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.LrcFile}" />
                                    <MenuItem Header="内嵌标签" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefEmbedded, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.Embedded}" />
                                    <MenuItem Header="网易云" IsCheckable="True"
                                              IsChecked="{Binding Player.Lyrics.IsPrefOnline, Mode=OneWay}"
                                              Command="{Binding Player.Lyrics.SetSourcePreferenceCommand}"
                                              CommandParameter="{x:Static lyr:LyricPreference.Online}" />
                                    <Separator />
                                    <MenuItem Header="{Binding Player.Lyrics.SourceText}" IsEnabled="False" />
                                </MenuItem>

                                <Separator />
                                <MenuItem Header="偏移 +0.1 秒" Command="{Binding Player.Lyrics.OffsetLaterCommand}" />
                                <MenuItem Header="{Binding Player.Lyrics.OffsetText}" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="重新获取" Command="{Binding Player.Lyrics.RefreshCommand}" />
                                <MenuItem Header="重新匹配…" Command="{Binding Player.Lyrics.RematchCommand}" />
                            </ContextMenu>
                        </Grid.ContextMenu>

                    <!-- 有时间轴：滚动高亮列表。右键：模式 / 偏移 / 重新获取 / 重新匹配 -->
                    <ListBox x:Name="LyricList"
                             ItemsSource="{Binding Player.Lyrics.Lines}"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource LyricRowStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseLeftButtonUp="OnLyricListClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding PrimaryText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SecondaryText}" FontSize="13" Opacity="0.65"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                                           </ListBox>

                    <!-- 无时间轴：整篇静态显示 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Player.Lyrics.HasTimeline, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="{Binding Player.Lyrics.PlainText}" FontSize="15" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="4,10" />
                    </ScrollViewer>

                    <!-- 空状态 / 加载中 -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Player.Lyrics.HasLyrics, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="DocumentText24" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextTertiaryBrush}" />
                        <TextBlock Text="{Binding Player.Lyrics.StatusText}" Margin="0,12,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource SubTextStyle}" />
                        <TextBlock Text="可以右键歌词区「重新匹配」从网易云候选中手动选择" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" Style="{StaticResource SubTextStyle}" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
