<Window x:Class="Player.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Player.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
        Title="Player" Height="580" Width="960" MinHeight="440" MinWidth="760"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        DragOver="Window_OnDragOver"
        Drop="Window_OnDrop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部信息条：引擎状态 + 提示信息 ===== -->
        <Grid Grid.Row="0" Margin="20,14,20,8">
            <TextBlock Text="{Binding EngineInfo}" Style="{StaticResource SubTextStyle}" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource SubTextStyle}"
                       Foreground="{StaticResource AccentBrush}"
                       HorizontalAlignment="Right" MaxWidth="520" />
        </Grid>

        <!-- ===== 主区：播放队列 / 空状态 ===== -->
        <Grid Grid.Row="1" Margin="14,4,14,10">

            <ListBox x:Name="QueueList"
                     Visibility="{Binding HasQueue, Converter={StaticResource BoolToVis}}"
                     ItemsSource="{Binding QueueItems}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource QueueItemStyle}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="QueueList_OnMouseDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="▶" FontSize="9" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Visibility="{Binding IsQueueEmpty, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="♪" FontSize="46" HorizontalAlignment="Center"
                           Foreground="{StaticResource TrackEmptyBrush}" />
                <TextBlock Text="把音频文件或文件夹拖进窗口即可播放" Margin="0,16,0,0"
                           HorizontalAlignment="Center" Style="{StaticResource TitleTextStyle}" />
                <TextBlock Text="mp3 · flac · m4a · ape · wv · ogg · opus · wav · aiff" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Style="{StaticResource SubTextStyle}" />
                <Button Content="打开文件…" Margin="0,20,0,0" HorizontalAlignment="Center"
                        Style="{StaticResource PillButtonStyle}"
                        Command="{Binding OpenFilesCommand}" />
            </StackPanel>
        </Grid>

        <!-- ===== 底部播放条 ===== -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="*" MaxWidth="230" />
                </Grid.ColumnDefinitions>

                <!-- 封面占位 + 曲目信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" CornerRadius="6"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <TextBlock Text="♪" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                    <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleTextStyle}" />
                        <TextBlock Text="{Binding Artist}" Style="{StaticResource SubTextStyle}" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding TechnicalInfo}" Style="{StaticResource SubTextStyle}"
                                   Margin="0,2,0,0" Opacity="0.7" />
                    </StackPanel>
                </StackPanel>

                <!-- 控制键 + 进度条 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding PreviousCommand}" ToolTip="上一首">
                            <Path Data="{StaticResource PreviousGeometry}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Margin="10,0"
                                Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停">
                            <Path Width="17" Height="17" Stretch="Uniform" Fill="#FF10131A">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Data" Value="{StaticResource PlayGeometry}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Data" Value="{StaticResource PauseGeometry}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>

                        <Button Style="{StaticResource TransportButtonStyle}"
                                Command="{Binding StopCommand}" ToolTip="停止">
                            <Path Data="{StaticResource StopGeometry}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform" />
                        </Button>

                        <Button Style="{StaticResource TransportButtonStyle}" Margin="4,0,0,0"
                                Command="{Binding NextCommand}" ToolTip="下一首">
                            <Path Data="{StaticResource NextGeometry}" Fill="{StaticResource TextPrimaryBrush}"
                                  Width="18" Height="18" Stretch="Uniform" />
                        </Button>
                    </StackPanel>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PositionText}" Style="{StaticResource SubTextStyle}"
                                   Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                        <Slider x:Name="SeekSlider" Grid.Column="1" Margin="10,0"
                                Style="{StaticResource SeekSliderStyle}"
                                Maximum="{Binding DurationSeconds}"
                                Value="{Binding PositionSeconds, Mode=TwoWay}"
                                IsEnabled="{Binding HasTrack}"
                                LargeChange="5" SmallChange="1"
                                PreviewMouseLeftButtonDown="SeekSlider_OnPreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekSlider_OnPreviewMouseLeftButtonUp" />
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource SubTextStyle}"
                                   Width="42" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- 音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Path Data="{StaticResource VolumeGeometry}" Fill="{StaticResource TextSecondaryBrush}"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                    <Slider Width="92" Margin="8,0" Maximum="1" LargeChange="0.1" SmallChange="0.05"
                            Value="{Binding Volume, Mode=TwoWay}"
                            Style="{StaticResource VolumeSliderStyle}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VolumePercentText}" Style="{StaticResource SubTextStyle}"
                               Width="34" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
