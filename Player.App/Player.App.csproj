<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- L2 SMTC：Windows 桌面 API（SystemMediaTransportControls）需要 Windows SDK 投影，TFM 升到 10.0.17763（探针 SmtcProbe 已验证编译+交叉发布） -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- L2 托盘：WinForms NotifyIcon（随 SDK 自带，无新增 NuGet 依赖） -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lyra 产品图标：托盘、任务栏、文件管理器和文件关联共用多尺寸 ICO。 -->
    <ApplicationIcon>Assets\lyra.ico</ApplicationIcon>
    <RootNamespace>Player.App</RootNamespace>
    <!-- 只改产品呈现层；RootNamespace 和工程文件名保持 Player。 -->
    <AssemblyName>Lyra</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 原生 bass 系列为 x64，进程必须是 64 位 -->
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- P6：exe 版本/产品元数据（文件关联"打开方式"与资源管理器详情共用） -->
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Lyra</Product>
    <Company>Lyra</Company>
    <Authors>Lyra</Authors>
    <Description>本地音乐播放器（Lyra）</Description>
    <Copyright>Copyright © 2026 Lyra</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\lyra.ico" />
  </ItemGroup>

  <!-- UseWindowsForms 会给全工程注入 System.Windows.Forms/System.Drawing 隐式 using，与 WPF 的 Point/事件类型冲突；去掉隐式、按需显式 using（TrayService） -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Player.Core\Player.Core.csproj" />
  </ItemGroup>

  <!-- BASS 原生 DLL（x64）随生成复制到输出目录根部；目录为空时该通配符不匹配任何文件，不会报错 -->
  <ItemGroup>
    <None Include="..\native\x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
