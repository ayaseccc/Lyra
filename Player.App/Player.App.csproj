<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- L2 SMTC：Windows 桌面 API（SystemMediaTransportControls）需要 Windows SDK 投影，TFM 升到 10.0.17763（探针 SmtcProbe 已验证编译+交叉发布） -->
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Player.App</RootNamespace>
    <!-- 产物即 PLAN 第 9 节的 Player.exe -->
    <AssemblyName>Player</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 原生 bass 系列为 x64，进程必须是 64 位 -->
    <PlatformTarget>x64</PlatformTarget>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Player.Core\Player.Core.csproj" />
  </ItemGroup>

  <!-- BASS 原生 DLL（x64）随生成复制到输出目录根部；目录为空时该通配符不匹配任何文件，不会报错 -->
  <ItemGroup>
    <None Include="..\native\x64\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
