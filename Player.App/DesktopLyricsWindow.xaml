<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Player.App.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="桌面歌词" Width="560" Height="120"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Top="860" Left="680"
        Loaded="OnLoaded" MouseLeftButtonDown="OnWindowMouseDown">
    <Grid>
        <!-- 圆角半透明背景条 -->
        <Border x:Name="Backdrop" CornerRadius="14" Opacity="0.82"
                Background="{DynamicResource SurfaceStrongBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                Margin="4" Padding="18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="PrimaryText" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="SecondaryText" Grid.Row="1" FontSize="14" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="Black" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 小柄：锁定态唯一可点的解锁按钮 -->
        <Border x:Name="UnlockHandle" Width="18" Height="18" CornerRadius="9"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource AccentBrush}" Cursor="Hand"
                ToolTip="解锁（拖动/调宽）" MouseLeftButtonUp="OnUnlockHandleClick">
            <ui:SymbolIcon Symbol="LockClosed24" FontSize="10" Foreground="#FF10131A"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 解锁态：调宽柄（右侧） -->
        <Border x:Name="ResizeHandle" Width="10" Height="36" CornerRadius="5"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,0"
                Background="{DynamicResource AccentBrush}" Cursor="SizeWE"
                Visibility="Collapsed" MouseLeftButtonDown="OnResizeHandleDown" />
    </Grid>
</Window>
