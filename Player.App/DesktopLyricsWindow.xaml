<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Player.App.DesktopLyricsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="桌面歌词" Width="560" Height="120"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Top="860" Left="680"
        Loaded="OnLoaded" MouseLeftButtonDown="OnWindowMouseDown">
    <Window.Resources>
        <!-- 悬浮设置面板的行样式（目验三修复：弃用系统子菜单，平铺按钮行，悬停高亮） -->
        <Style x:Key="MenuRowStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.3" />
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid MouseEnter="OnRootMouseEnter" MouseLeave="OnRootMouseLeave" Background="Transparent"
          PreviewMouseRightButtonUp="OnRootPreviewMouseRightButtonUp">
        <!-- 圆角半透明背景条（L1.1-③：可隐藏/调透明；目验修复①：文字层与背景分离，隐藏背景不丢文字） -->
        <Border x:Name="Backdrop" CornerRadius="14" Opacity="0.82"
                Background="{DynamicResource SurfaceStrongBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                Margin="4" />

        <!-- 文字层：独立于背景卡片，始终显示（目验修复③：垂直居中，不再顶对齐） -->
        <Grid Margin="4" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="PrimaryText" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center"
                       TextWrapping="Wrap" Padding="18,0">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="PrimaryShadow" BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock x:Name="SecondaryText" Grid.Row="1" FontSize="14" Margin="18,4,18,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Effect>
                    <DropShadowEffect x:Name="SecondaryShadow" BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="Black" />
                </TextBlock.Effect>
            </TextBlock>
        </Grid>

        <!-- 悬停迷你工具条（L1.1-③：解锁态悬停左上角显示，含锁定按钮——解锁后唯一再锁定入口） -->
        <StackPanel x:Name="HoverToolbar" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="10,8,0,0" Visibility="Collapsed">
            <Border Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="8" Padding="4"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" Opacity="0.95">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ToolbarLockButton" Width="26" Height="26" Style="{StaticResource ModeButtonStyle}"
                            ToolTip="锁定（鼠标穿透）" Click="OnToolbarLockClick">
                        <ui:SymbolIcon Symbol="LockClosed24" FontSize="12" />
                    </Button>
                    <Button x:Name="ToolbarCloseButton" Width="26" Height="26" Style="{StaticResource ModeButtonStyle}"
                            Margin="4,0,0,0" ToolTip="关闭桌面歌词" Click="OnToolbarCloseClick">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                    </Button>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 小柄：锁定态唯一可点的解锁按钮 -->
        <Border x:Name="UnlockHandle" Width="18" Height="18" CornerRadius="9" Opacity="0"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="{DynamicResource AccentBrush}" Cursor="Hand"
                ToolTip="解锁（拖动/调宽）" MouseLeftButtonUp="OnUnlockHandleClick">
            <ui:SymbolIcon Symbol="LockClosed24" FontSize="10" Foreground="#FF10131A"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 解锁态：调宽柄（右侧；背景隐藏时一并隐藏，避免悬浮小条——目验三修复）
             用户反馈加大：18×48、窗口内露出更多，拖动显式捕获 -->
        <Border x:Name="ResizeHandle" Width="18" Height="48" CornerRadius="6"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-2,0"
                Background="{DynamicResource AccentBrush}" Cursor="SizeWE"
                AutomationProperties.Name="调整宽度"
                Visibility="Collapsed" MouseLeftButtonDown="OnResizeHandleDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.35" />
            </Border.Effect>
        </Border>

        <!-- 自定义悬浮设置面板（目验三修复：平铺行 + 色板，无系统子菜单走廊问题；右键解锁态打开） -->
        <Popup x:Name="SettingsPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource SurfaceStrongBrush}" CornerRadius="10" Padding="6"
                    BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" MinWidth="210">
                <StackPanel>
                    <Button x:Name="MenuLockRow" Style="{StaticResource MenuRowStyle}" Click="OnMenuToggleLock" />
                    <Button x:Name="MenuTwoLinesRow" Style="{StaticResource MenuRowStyle}" Click="OnMenuToggleTwoLines" />
                    <Button x:Name="MenuBgRow" Style="{StaticResource MenuRowStyle}" Click="OnMenuToggleBackground" />

                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,6" />

                    <!-- 字号 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource MenuRowStyle}" MinWidth="44" Content="A−"
                                ToolTip="字号减小" Click="OnMenuFontSizeMinus" />
                        <TextBlock Grid.Column="1" x:Name="MenuFontSizeText" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Grid.Column="2" Style="{StaticResource MenuRowStyle}" MinWidth="44" Content="A+"
                                ToolTip="字号增大" Click="OnMenuFontSizePlus" />
                    </Grid>

                    <!-- 背景透明度 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource MenuRowStyle}" Content="30%" Tag="0.3" Click="OnMenuBgOpacity" />
                        <Button Grid.Column="1" Style="{StaticResource MenuRowStyle}" Content="50%" Tag="0.5" Click="OnMenuBgOpacity" />
                        <Button Grid.Column="2" Style="{StaticResource MenuRowStyle}" Content="70%" Tag="0.7" Click="OnMenuBgOpacity" />
                        <Button Grid.Column="3" Style="{StaticResource MenuRowStyle}" Content="90%" Tag="0.9" Click="OnMenuBgOpacity" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,6" />

                    <!-- 文字颜色色板（跟随主题 + 预设纯色） -->
                    <TextBlock Text="文字颜色" FontSize="11" Margin="10,2,0,4"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <WrapPanel x:Name="MenuColorSwatches" />

                    <!-- 字体设置入口 -->
                    <Button Style="{StaticResource MenuRowStyle}" Content="字体设置…" Click="OnMenuFontSettings" />

                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,6" />

                    <Button Style="{StaticResource MenuRowStyle}" Content="关闭桌面歌词" Click="OnMenuClose" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
