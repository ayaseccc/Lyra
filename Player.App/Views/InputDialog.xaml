<ui:FluentWindow x:Class="Player.App.Views.InputDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Player" Width="400" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" ShowMaximize="False" ShowMinimize="False"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />

        <StackPanel Grid.Row="1" Margin="20,4,20,20">
            <TextBlock x:Name="LabelText" Style="{StaticResource SubTextStyle}" Text="名称" />
            <ui:TextBox x:Name="InputBox" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <ui:Button Content="取消" MinWidth="80" Click="OnCancelClick" IsCancel="True" />
                <ui:Button Content="确定" MinWidth="80" Margin="8,0,0,0" Appearance="Primary"
                           Click="OnOkClick" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
