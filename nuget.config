<?xml version="1.0" encoding="utf-8"?>
<!--
  离线构建辅助（本机无法访问 nuget.org 时使用）：
  tools/nuget-offline 里放的是从 publish/ 产物重建的包（id/version 结构），
  由 rebuild-nuget-cache.ps1 生成。有网环境直接删掉本文件或 tools/nuget-offline 即可。
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
    <add key="offline" value="tools/nuget-offline" />
  </fallbackPackageFolders>
</configuration>
