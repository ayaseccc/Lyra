<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 纯 net8.0：核心层不引用任何 WPF / Windows Desktop 类型（PLAN 第 3 节） -->
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Player.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Asio" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Mix" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Wasapi" Version="4.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.30" />
    <!-- Microsoft.Data.Sqlite 8.0.30 references SQLitePCLRaw 2.1.12; pin the bundle so
         an older global NuGet cache cannot leave a runtime-incompatible 2.1.6 assembly. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Player.Harness" />
  </ItemGroup>

</Project>
